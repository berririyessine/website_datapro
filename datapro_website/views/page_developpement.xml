                        <div class="dev-proc-grid dp-reveal">
                            <div class="dev-proc-step">
                                <div class="dev-ps-num">01</div>
                                <div class="dev-ps-ico">📋</div>
                                <div class="dev-ps-t">Spécification</div>
                                <div class="dev-ps-s">Cahier des charges technique précis avant la première ligne de code</div>
                            </div>
                            <div class="dev-ps-arrow">→</div>
                            <div class="dev-proc-step">
                                <div class="dev-ps-num">02</div>
                                <div class="dev-ps-ico">🌿</div>
                                <div class="dev-ps-t">Branche staging</div>
                                <div class="dev-ps-s">Développement isolé, tests sur Odoo.sh staging avant prod</div>
                            </div>
                            <div class="dev-ps-arrow">→</div>
                            <div class="dev-proc-step">
                                <div class="dev-ps-num">03</div>
                                <div class="dev-ps-ico">✅</div>
                                <div class="dev-ps-t">Recette client</div>
                                <div class="dev-ps-s">Validation fonctionnelle à chaque sprint de 2 semaines</div>
                            </div>
                            <div class="dev-ps-arrow">→</div>
                            <div class="dev-proc-step">
                                <div class="dev-ps-num">04</div>
                                <div class="dev-ps-ico">🚀</div>
                                <div class="dev-ps-t">Mise en prod</div>
