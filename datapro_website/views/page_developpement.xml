                            </div>
                            <div class="dev-ps-arrow">→</div>
                            <div class="dev-proc-step">
                                <div class="dev-ps-num">05</div>
                                <div class="dev-ps-ico">📚</div>
                                <div class="dev-ps-t">Documentation</div>
                                <div class="dev-ps-s">Doc technique complète + formation équipes</div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ═══ CTA FINAL ═══ -->
                <section class="dev-cta-final">
                    <div class="dp-inner dev-cta-inner">
                        <h2 class="dev-cta-title">
                            Votre projet de développement ?<br/>
                            <span class="dev-cta-em">On en parle.</span>
                        </h2>
                        <p class="dev-cta-sub">Devis sous 24h · Expertise senior</p>
                        <div class="dev-cta-btns">
                            <button class="dev-cta-btn-p" onclick="window.location='/contact'">💻 Décrire mon projet</button>
                            <button class="dev-cta-btn-g" onclick="window.open('https://wa.me/21698631289','_blank')">💬 WhatsApp direct</button>
                        </div>
                    </div>
                </section>

                <!-- ─── FOOTER ─── -->
                <t t-call="datapro_website.dp_footer"/>

            </div><!-- /.dp-page -->
        </t>
    </template>

    <record id="website_page_developpement" model="website.page">
        <field name="name">Data Pro — Développement Sur Mesure</field>
        <field name="url">/developpement</field>
        <field name="view_id" ref="datapro_website.page_developpement"/>
        <field name="website_indexed" eval="True"/>
        <field name="is_published" eval="True"/>
    </record>

</odoo>
