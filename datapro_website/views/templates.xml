    <!-- ══════════════════════════════════════════════════
         INJECTION GOOGLE FONTS dans le <head>
         DM Serif Display · DM Sans
    ══════════════════════════════════════════════════ -->
    <template id="assets_frontend_fonts"
              inherit_id="website.layout"
              name="Data Pro — Google Fonts">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
            <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&amp;family=DM+Sans:wght@300;400;500;600;700&amp;display=swap"
                  rel="stylesheet"/>
        </xpath>
    </template>


    <!-- ══════════════════════════════════════════════════
         LOGO SOCIÉTÉ — champ "Logo" de la configuration
         Réglages > Utilisateurs & Sociétés > Sociétés
         Réutilisé dans tous les headers + le footer.
    ══════════════════════════════════════════════════ -->
    <template id="dp_logo_img" name="Data Pro — Logo (société)">
        <img t-attf-src="/web/image/res.company/#{website.company_id.id}/logo"
