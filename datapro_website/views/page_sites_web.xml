                                <span class="web-trust-item">✅ SEO technique</span>
                                <span class="web-trust-item">✅ Paiement en ligne</span>
                                <span class="web-trust-item">✅ Mobile-first</span>
                            </div>
                        </div>
                        <div class="web-hero-right">
                            <div class="web-kpi-grid">
                                <div class="web-kpi">
                                    <div class="web-kpi-val">8</div>
                                    <div class="web-kpi-label">Sprints de livraison</div>
                                    <div class="web-kpi-sub">Alfaprint.fr · Refonte complète</div>
                                </div>
                                <div class="web-kpi">
                                    <div class="web-kpi-val">100%</div>
                                    <div class="web-kpi-label">Custom design</div>
                                    <div class="web-kpi-sub">Aucun template générique</div>
                                </div>
                                <div class="web-kpi">
                                    <div class="web-kpi-val">Core Web</div>
                                    <div class="web-kpi-label">Vitals optimisés</div>
                                    <div class="web-kpi-sub">Performance &amp; SEO</div>
                                </div>
                                <div class="web-kpi">
                                    <div class="web-kpi-val">FR + TN</div>
                                    <div class="web-kpi-label">Marchés couverts</div>
                                    <div class="web-kpi-sub">Bilingue FR / AR</div>
                                </div>
                            </div>
                        </div>
                    </div>
