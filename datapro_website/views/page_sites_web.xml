                                    <li>✓ Champs Type d'achat + Mois</li>
                                    <li>✓ Détection auto « article de type service »</li>
                                    <li>✓ Imputation analytique fiabilisée</li>
                                </ul>
                            </div>

                            <div class="web-off-card web-oc-blue">
                                <div class="web-oc-ico">✅</div>
                                <div class="web-oc-title">Les Bénéfices</div>
                                <div class="web-oc-desc">
                                    Moins de corrections pour les équipes, un reporting enfin exploitable
                                    pour les managers, et une donnée analytique fiable à chaque saisie.
                                </div>
                                <ul class="web-oc-list">
                                    <li>✓ Utilisateurs : gain de temps, données fiabilisées</li>
                                    <li>✓ Managers : reporting exploitable, contrôle budgétaire renforcé</li>
                                    <li>✓ Conformité : Source Projet obligatoire à la saisie</li>
                                </ul>
                            </div>

                        </div>
                    </div>
                </section>

                <!-- ═══ CTA FINAL ═══ -->
                <section class="web-cta-final">
                    <div class="dp-inner web-cta-inner">
                        <h2 class="web-cta-title">
                            Votre prochain site web ?<br/>
                            <span class="web-cta-em">On commence par un audit gratuit.</span>
                        </h2>
                        <p class="web-cta-sub">Devis sous 24h · Design sur mesure</p>
                        <div class="web-cta-btns">
                            <button class="web-cta-btn-p" onclick="window.location='/contact'">🌐 Devis site gratuit</button>
                            <button class="web-cta-btn-g" onclick="window.open('https://wa.me/21698631289','_blank')">💬 WhatsApp direct</button>
                        </div>
                    </div>
                </section>

                <!-- ─── FOOTER ─── -->
                <t t-call="datapro_website.dp_footer"/>

            </div><!-- /.dp-page -->
        </t>
    </template>

    <record id="website_page_sites_web" model="website.page">
        <field name="name">Data Pro — Sites Web &amp; E-commerce Odoo</field>
        <field name="url">/sites-web</field>
        <field name="view_id" ref="datapro_website.page_sites_web"/>
        <field name="website_indexed" eval="True"/>
        <field name="is_published" eval="True"/>
    </record>

</odoo>
